# Copy this file to .env.local and fill in real values. .env.local is never committed.

# Signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Neon pooled connection string used by the app at runtime
DATABASE_URL=

# Neon direct (unpooled) connection string used by migrations
DATABASE_URL_UNPOOLED=

# Optional. A free AwesomeAPI key (awesomeapi.com.br) raises the per-IP rate limit.
# Leave empty to call the API without a key.
AWESOMEAPI_KEY=

# Optional. Only for tests (the smoke test points this at a fake API).
AWESOMEAPI_BASE_URL=

# Set for the Production environment only, not Preview. Vercel Cron sends it as a Bearer token; ≥ 32 random characters.
CRON_SECRET=

# Set for the Production environment only, not Preview. API key of the house_bot account; the cron route trades with it.
HOUSE_BOT_API_KEY=

# Set for the Production environment only, not Preview. API key of the random_bot account; the cron route trades with it.
RANDOM_BOT_API_KEY=
