# Copy this file to .env.local and fill in real values. .env.local is never committed.

# Signs the session cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Neon pooled connection string used by the app at runtime
DATABASE_URL=

# Neon direct (unpooled) connection string used by migrations
DATABASE_URL_UNPOOLED=

# Password for the "demo" account
DEMO_PASSWORD=

# Optional. A free AwesomeAPI key (awesomeapi.com.br) raises the per-IP rate limit.
# Leave empty to call the API without a key.
AWESOMEAPI_KEY=
